     class Program {
 
+        // Dump every template's authoritative field layout using this build's own serializer,
+        // for NMSRetroPy per-version struct generation.
+        static void DumpLayout()
+        {
+            var baseType = typeof(NMSTemplate);
+            var types = baseType.Assembly.GetTypes()
+                .Where(t => baseType.IsAssignableFrom(t) && t != baseType && !t.IsAbstract)
+                .OrderBy(t => t.Name);
+            var sb = new StringBuilder("{");
+            bool firstT = true;
+            foreach (var t in types)
+            {
+                NMSTemplate tmpl = null;
+                try { tmpl = NMSTemplate.TemplateFromName(t.Name); } catch { }
+                if (tmpl == null) continue;
+                NMSTemplate.CaptureOffsets = true;
+                NMSTemplate.CaptureDepth = 0;
+                NMSTemplate.CapturedFields.Clear();
+                int total = -1;
+                try { total = tmpl.GetDataSize(); } catch { }
+                NMSTemplate.CaptureOffsets = false;
+                var caps = new List<Tuple<string, long, string>>(NMSTemplate.CapturedFields);
+                if (caps.Count == 0) continue;
+                if (!firstT) sb.Append(",");
+                firstT = false;
+                sb.Append("\"" + t.Name + "\":{\"size\":" + total + ",\"fields\":[");
+                for (int i = 0; i < caps.Count; i++)
+                {
+                    long off = caps[i].Item2;
+                    long size = (i + 1 < caps.Count ? caps[i + 1].Item2 : total) - off;
+                    if (i > 0) sb.Append(",");
+                    sb.Append("{\"name\":\"" + caps[i].Item1 + "\",\"type\":\"" + caps[i].Item3
+                              + "\",\"offset\":" + off + ",\"size\":" + size + "}");
+                }
+                sb.Append("]}");
+            }
+            sb.Append("}");
+            Console.Out.Write(sb.ToString());
+        }
+
